# Copy to deploy/.env and fill in. Never commit deploy/.env.

DB_USER=gymcrm
DB_NAME=gymcrm

# Generate, do not invent:  openssl rand -base64 24
DB_PASSWORD=

# Generate, do not invent:  openssl rand -base64 48
# Anyone holding this can mint a valid token for any gym.
JWT_SECRET=

# Port nginx listens on. Set to 8080 if a TLS reverse proxy owns port 80.
HTTP_PORT=80

# Leave EMPTY for the same-origin deployment this compose file sets up.
# Only set it if the app is served from a different hostname than the API.
CORS_ALLOWED_ORIGINS=

# ── TLS (only needed for the docker-compose.tls.yml overlay) ────────────────
# The domain this server answers on. Must already point at this machine.
DOMAIN=gym.example.com

# Where Let's Encrypt sends certificate-expiry warnings. Use a real address.
LETSENCRYPT_EMAIL=

# Set to 1 while debugging. Staging certificates are NOT trusted by browsers,
# but staging has a far higher rate limit — the live server blocks you for an
# hour after 5 failures.
LETSENCRYPT_STAGING=0

# ── Who may create a gym on this server ─────────────────────────────────────
# The register endpoint creates a gym AND its owner, and is unauthenticated by
# necessity — there is nobody to authenticate as before the gym exists.
#
# In production it is CLOSED unless one of these is set:
#
#   REGISTRATION_INVITE_CODE=some-long-random-string
#     A gym can be created only by someone you gave the code to. Recommended
#     while onboarding gyms one at a time.
#
#   ALLOW_PUBLIC_REGISTRATION=true
#     Anyone who reaches the server can create a gym. Only set this if
#     self-serve signup is genuinely your business model, and add rate
#     limiting before you do.
REGISTRATION_INVITE_CODE=
ALLOW_PUBLIC_REGISTRATION=false
